{
  "name": "escaphere",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:mapgen": "tsc -p scripts/tsconfig.mapgen.json && node scripts/check-mapgen.js",
    "build:web": "expo export --platform web --output-dir dist && node scripts/inject-pwa-tags.js",
    "check:layout": "node scripts/check-layout.js",
    "check:pwa": "node scripts/check-pwa.js",
    "test:logic": "tsc -p scripts/tsconfig.mapgen.json && node scripts/run-logic-tests.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.1",
    "expo": "~55.0.4",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-haptics": "^55.0.8",
    "expo-linear-gradient": "^55.0.8",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "^4.2.2",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "playwright": "^1.62.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
